datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  role          String        @default("SITE_SUPERVISOR") // "BUILDER_ADMIN" or "SITE_SUPERVISOR"
  accounts      Account[]
  sessions      Session[]
  reports       DailyReport[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DailyReport {
  id              String   @id @default(uuid())
  date            DateTime @default(now())
  workersPresent  Int
  tasksCompleted  String // Stored as newline-separated achievements
  materialsUsed   String // Stored as newline-separated items
  attendancePhoto String? // Local URL path
  progressPhoto1  String? // Local URL path (optional)
  progressPhoto2  String? // Local URL path (optional)
  supervisorId    String
  supervisor      User     @relation(fields: [supervisorId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
