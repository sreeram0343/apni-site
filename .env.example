# NextAuth/Auth.js configuration
# Generate a secret via: npx auth secret
AUTH_SECRET="your-32-character-secret-key-goes-here"

# Figma MCP Integration Config
FIGMA_API_KEY="your_figma_personal_access_token_here"

# Production Database Connection (PostgreSQL/Neon/Supabase)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"
