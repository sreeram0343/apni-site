# ==========================================
# 1. LOCAL DEVELOPMENT (SQLite)
# ==========================================
# Use these variables in your local .env or .env.local file.
# Note: prisma/schema.prisma is configured for SQLite by default locally.

DATABASE_URL="file:./dev.db"
AUTH_SECRET="apni-site-local-demo-secret"


# ==========================================
# 2. PRODUCTION DEPLOYMENT (PostgreSQL / Supabase)
# ==========================================
# Configure these variables in your Netlify or Vercel dashboard.
# Note: The build script automatically compiles the client for PostgreSQL in production.

# Production Database URL (Pooling Mode - usually port 6543 for Supabase, SSL required)
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://username:password@hostname:6543/dbname?sslmode=require"

# Production Direct URL (Direct Mode - usually port 5432 for Supabase, bypasses pooler)
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DIRECT_URL="postgresql://username:password@hostname:5432/dbname"

# A secure random secret used to sign session cookies (generate with `npx auth secret`)
AUTH_SECRET="your-32-character-secret-key-goes-here"
